# Application
APP_NAME=Course Finder API
APP_VERSION=1.0.0
DEBUG=True
API_PREFIX=/api/v1

# Database (matching docker-compose.yml credentials)
DATABASE_USER=course_finder_user
DATABASE_PASSWORD=securepassword
DATABASE_HOST=python-backend-db
DATABASE_PORT=5432
DATABASE_NAME=course_finder_db

POSTGRES_USER=course_finder_user
POSTGRES_PASSWORD=securepassword
POSTGRES_DB=course_finder_db

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# JWT Authentication (RSA)
# Path to the RSA public key file (relative to project root)
JWT_PUBLIC_KEY_PATH=keys/public-key.pem
# Algorithm used for JWT verification (should match the auth service)
JWT_ALGORITHM=RS256