# Example environment variables for the frontend
# Copy this file to .env.development or .env.production and adjust values as needed

# Auth API URL (Java backend)
# Development: /auth-api (uses Vite proxy from vite.config.ts)
# Production: /auth-api (uses Nginx proxy)
VITE_AUTH_API_URL=/auth-api

# Course API URL (Python backend)
# Development: /course-api (uses Vite proxy from vite.config.ts)
# Production: /course-api (uses Nginx proxy)
VITE_COURSE_API_URL=/course-api
